{
  "name": "bike-ride-bot",
  "version": "2.9.0",
  "description": "Telegram bot for organizing bike rides",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development nodemon src/index.js",
    "test": "MONGOMS_DOWNLOAD_DIR=/tmp/mongodb-binaries node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=30000 --runInBand",
    "test:coverage": "MONGOMS_DOWNLOAD_DIR=/tmp/mongodb-binaries node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=30000 --runInBand --coverage",
    "test:basic": "npm run test -- --testPathIgnorePatterns=mongodb-storage.test.js",
    "test:mongo": "npm run test -- src/__tests__/storage/mongodb-storage.test.js",
    "test:coverage:basic": "npm run test:coverage -- --testPathIgnorePatterns=mongodb-storage.test.js",
    "e2e:bootstrap-session": "node e2e/bootstrap-session.js",
    "e2e:telegram": "node e2e/run-e2e.js",
    "e2e:run": "node e2e/run-e2e-full-stack.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@grammyjs/conversations": "^2.1.1",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "telegram": "^2.26.22"
  },
  "type": "module",
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/src/test-setup/jest-env.js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/storage/interface.js",
      "!src/migrations/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 65,
        "lines": 72,
        "statements": 72
      }
    }
  }
}
